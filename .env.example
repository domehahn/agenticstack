# Cloudflare API Credentials
# 
# SICHERHEIT:
# - Diese Datei niemals mit realen Werten committen
# - Verwende API Tokens, keine Global API Keys
# - Tokens haben minimale erforderliche Berechtigungen (Least Privilege)
# 
# Erforderliche Berechtigungen für API Token:
# - Zone:Read (alle Zonen)
# - Zone Settings:Edit (nur agenticstack.eu)
# - Zone Settings:Read (nur agenticstack.eu)
# 
# Optional (falls Security.txt über API konfiguriert wird):
# - Account Settings:Read
# - Account Settings:Edit
# 
# Erstellen eines API Tokens:
# 1. Cloudflare Dashboard → My Profile → API Tokens
# 2. Create Token → Custom Token
# 3. Permissions hinzufügen (siehe oben)
# 4. Zone Resources: Include → Specific zone → agenticstack.eu
# 5. Continue to summary → Create Token
# 6. Token kopieren und hier eintragen

# Cloudflare API Token (erforderlich)
CLOUDFLARE_API_TOKEN=your_api_token_here

# Cloudflare Zone ID für agenticstack.eu (optional, wird automatisch aufgelöst)
CLOUDFLARE_ZONE_ID=your_zone_id_here

# Cloudflare Account ID (nur erforderlich für Account-weite Einstellungen)
# CLOUDFLARE_ACCOUNT_ID=your_account_id_here
