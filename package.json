{
  "name": "agenticstack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:content": "node scripts/generate-content-manifest.mjs",
    "predev": "npm run generate:content",
    "dev": "next dev",
    "prebuild": "npm run generate:content",
    "build": "next build",
    "start": "wrangler dev",
    "lint": "eslint",
    "pretest": "npm run generate:content",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "cloudflare:audit": "tsx scripts/cloudflare-audit.mts",
    "cloudflare:plan": "tsx scripts/cloudflare-audit.mts",
    "cloudflare:apply": "tsx scripts/cloudflare-audit.mts --apply",
    "production:audit": "tsx scripts/cloudflare-audit.mts production"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.12",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mdx": "^2.0.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "feed": "^6.0.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.27.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.125.0"
  }
